// Reusable Custom StudentCard Widget
class StudentCard extends StatelessWidget {
  final String name;
  final String branch;
  final String cgpa;
  final IconData icon;

  const StudentCard({
    super.key,
    required this.name,
    required this.branch,
    required this.cgpa,
    required this.icon,
  });

  @override
  Widget build(BuildContext context) {
    return Card(
      elevation: 5,
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(15),
      ),

      child: Padding(
        padding: const EdgeInsets.all(16.0),

        child: Row(
          children: [

            // Student Icon
            CircleAvatar(
              radius: 35,
              backgroundColor: Colors.blue[100],
              child: Icon(
                icon,
                size: 40,
                color: Colors.blue,
              ),
            ),

            const SizedBox(width: 20),

            // Student Details
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [

                  // Student Name
                  Text(
                    name,
                    style: const TextStyle(
                      fontSize: 22,
                      fontWeight: FontWeight.bold,
                      color: Colors.black87,
                    ),
                  ),

                  const SizedBox(height: 8),

                  // Branch
                  Text(
                    'Branch: $branch',
                    style: const TextStyle(
                      fontSize: 16,
                      color: Colors.black54,
                    ),
                  ),

                  const SizedBox(height: 5),

                  // CGPA
                  Text(
                    'CGPA: $cgpa',
                    style: const TextStyle(
                      fontSize: 16,
                      color: Colors.black54,
                    ),
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}
